{
  "name": "tim-curry-in-nz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opinionated starter template: Next.js + TypeScript strict + Tailwind 4 + Vitest + Playwright, fully automated.",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "images:sync": "node scripts/sync-commons-images.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "audit": "npm audit",
    "test:setup": "node --test scripts/setup.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:setup && npm run build && npm run smoke && npm run test:e2e && npm run check:links",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/spectral": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-jsdoc": "65.4.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0",
    "vitest": "5.0.5",
    "vitest-axe": "0.1.0"
  }
}
